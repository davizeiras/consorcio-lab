PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
# DATA_DIR=./data
# Em redes que exigem proxy, com Node 24.5+: NODE_USE_ENV_PROXY=1

# Migração de acesso: public mantém o comportamento atual; required exige contas.
AUTH_MODE=public
# Só ativar required depois da configuração descrita em docs/ATIVAR-ACESSOS.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
